#!/usr/bin/env bash
set -euo pipefail

PROJECT_REPO="https://github.com/<owner>/automl-synth.git"
REQUIRED_PYTHON="3.11"

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

if ! command_exists python3; then
  echo "Python 3 is required. Please install Python ${REQUIRED_PYTHON}+ first."
  exit 1
fi

PY_VERSION=$(python3 - <<'PY'
import sys
print(f"{sys.version_info.major}.{sys.version_info.minor}")
PY
)

echo "Detected Python: ${PY_VERSION}"

python3 - <<'PY'
import sys
if sys.version_info < (3, 11):
    raise SystemExit("Python 3.11+ is required.")
PY

if ! command_exists pipx; then
  echo "Installing pipx..."
  python3 -m pip install --user pipx
  python3 -m pipx ensurepath || true
fi

echo "Installing AutoML-Synth..."
pipx install "git+${PROJECT_REPO}" --force

echo "Verifying installation..."
automl-synth --help >/dev/null

echo "Running doctor..."
automl-synth doctor || true

cat <<'NEXT'

Installation complete.

Next setup your LLM provider:

export LLM_PROVIDER=openrouter
export LLM_BASE_URL=https://openrouter.ai/api/v1
export LLM_API_KEY="your_key_here"
export LLM_MODEL="openrouter/free"

Then run:

automl-synth generate --topic "Classify news headlines into politics, sports, technology, entertainment, and business" --rows 300 --out ./output

NEXT
